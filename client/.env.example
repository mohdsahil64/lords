# Backend API origin.
#
# Development: leave empty — the Vite dev proxy forwards /api to localhost:5000.
# Production (Vercel): set this to your VPS backend's full origin, no trailing
# slash and no "/api" suffix. Example:
#
#   VITE_API_URL=https://api.yourdomain.com
#
# Then every axios call ("/api/verify/cert", "/api/auth/login", ...) hits the
# VPS backend instead of the Vercel frontend domain.
VITE_API_URL=
